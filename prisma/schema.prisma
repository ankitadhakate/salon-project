generator client {
  provider = "prisma-client-js"
}

// SQLite keeps local setup to one file. For Postgres, change the provider
// and create a fresh migration (see README). Field types below stay portable.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// OWNER accounts self-signup. ADMIN is seeded, never chosen on the public form.
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String?
  role         String      @default("OWNER")
  referralCode String?
  isDemo       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  salon        Salon?
  magicLinks   MagicLink[]
}

model MagicLink {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// status: DRAFT | PENDING | LIVE | HIDDEN
// gender: MEN | WOMEN | UNISEX
model Salon {
  id             String        @id @default(cuid())
  ownerId        String        @unique
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  areaSlug       String
  address        String
  description    String        @default("")
  phone          String        @default("")
  whatsapp       String        @default("")
  gender         String        @default("UNISEX")
  status         String        @default("DRAFT")
  isEarlyPartner Boolean       @default(true)
  isDemo         Boolean       @default(false)
  referralCode   String?
  startingPrice  Int?
  searchBlob     String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  photos         Photo[]
  services       Service[]
  hours          OpeningHour[]

  @@unique([areaSlug, slug])
  @@index([status, areaSlug])
  @@index([isDemo])
}

model Photo {
  id         String @id @default(cuid())
  salonId    String
  salon      Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  alt        String @default("")
  sortOrder  Int    @default(0)

  @@index([salonId])
}

model Service {
  id          String @id @default(cuid())
  salonId     String
  salon       Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  category    String
  priceInr    Int
  durationMin Int
  sortOrder   Int    @default(0)

  @@index([salonId])
}

// dayOfWeek: 0 Monday … 6 Sunday. Times are 24h "HH:MM" in Asia/Kolkata.
model OpeningHour {
  id        String  @id @default(cuid())
  salonId   String
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  closed    Boolean @default(false)
  openTime  String  @default("10:00")
  closeTime String  @default("20:00")

  @@unique([salonId, dayOfWeek])
}

model Locality {
  slug      String @id
  name      String
  city      String @default("Pune")
  sortOrder Int    @default(0)
}

// key "requireApproval": "true" | "false"
model SiteSetting {
  key   String @id
  value String
}
