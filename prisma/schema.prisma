generator client {
  provider = "prisma-client-js"
}

// Local development and production both use Postgres. See DEPLOY.md.
// directUrl is the non-pooled connection Prisma Migrate uses. Set it to the
// same value as DATABASE_URL when there is no pooler.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// OWNER accounts self-signup. ADMIN is seeded from env, never chosen on the public form.
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String?
  role         String      @default("OWNER")
  referralCode String?
  isDemo       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  salon        Salon?
  magicLinks   MagicLink[]
}

model MagicLink {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// A launch city. Copy, URLs, and the home picker all read this table.
// intro is written by the team. An empty intro keeps the city page out of the index.
model City {
  slug          String         @id
  name          String
  countryCode   String         @default("IN")
  dialCode      String         @default("91")
  timezone      String         @default("Asia/Kolkata")
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  intro         String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  localities    Locality[]
  serviceGuides ServiceGuide[]
  salons        Salon[]
}

model Locality {
  id        String  @id @default(cuid())
  citySlug  String
  city      City    @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
  slug      String
  name      String
  intro     String  @default("")
  sortOrder Int     @default(0)
  salons    Salon[]

  @@unique([citySlug, slug])
  @@index([citySlug, sortOrder])
}

// A service landing page for one city, such as /{city}/service/haircut.
// query is the lowercase phrase matched against a salon's search text.
model ServiceGuide {
  id        String @id @default(cuid())
  citySlug  String
  city      City   @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
  slug      String
  name      String
  query     String
  intro     String @default("")
  sortOrder Int    @default(0)

  @@unique([citySlug, slug])
  @@index([citySlug, sortOrder])
}

// status: DRAFT | PENDING | LIVE | HIDDEN
// gender: MEN | WOMEN | UNISEX
model Salon {
  id             String        @id @default(cuid())
  // Null until an owner claims a listing the team created.
  ownerId        String?       @unique
  owner          User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  citySlug       String
  city           City          @relation(fields: [citySlug], references: [slug])
  name           String
  slug           String
  areaSlug       String
  locality       Locality      @relation(fields: [citySlug, areaSlug], references: [citySlug, slug])
  address        String
  latitude       Float?
  longitude      Float?
  // Owner-pasted Google Maps link. Directions use this when it is still a Maps URL.
  mapsUrl        String?
  description    String        @default("")
  phone          String        @default("")
  whatsapp       String        @default("")
  gender         String        @default("UNISEX")
  status         String        @default("DRAFT")
  isEarlyPartner Boolean       @default(true)
  isDemo         Boolean       @default(false)
  referralCode   String?
  startingPrice  Int?
  searchBlob     String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  photos         Photo[]
  services       Service[]
  hours          OpeningHour[]
  stats          SalonStat[]
  statEvents     StatDedup[]
  audits         ListingAudit[]
  claimInvites   ClaimInvite[]

  @@unique([citySlug, areaSlug, slug])
  @@index([status, citySlug, areaSlug])
  @@index([status, isDemo, citySlug, areaSlug, startingPrice])
  @@index([latitude, longitude])
  @@index([isDemo])
}

model Photo {
  id         String @id @default(cuid())
  salonId    String
  salon      Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  alt        String @default("")
  sortOrder  Int    @default(0)

  @@index([salonId])
}

model Service {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  category    String
  priceInr    Int
  durationMin Int
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([salonId])
}

// dayOfWeek: 0 Monday … 6 Sunday. Times are 24h "HH:MM" in the city's timezone.
model OpeningHour {
  id        String  @id @default(cuid())
  salonId   String
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  closed    Boolean @default(false)
  openTime  String  @default("10:00")
  closeTime String  @default("20:00")

  @@unique([salonId, dayOfWeek])
}

// key "requireApproval": "true" | "false"
model SiteSetting {
  key   String @id
  value String
}

// Daily totals. A visitor id, IP, or account is not stored on this row.
model SalonStat {
  id         String   @id @default(cuid())
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  day        DateTime @db.Date
  views        Int      @default(0)
  calls        Int      @default(0)
  whatsapps    Int      @default(0)
  directions   Int      @default(0)
  appointments Int      @default(0)
  shares       Int      @default(0)

  @@unique([salonId, day])
  @@index([salonId])
}

model ClaimInvite {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  email     String    @default("")
  phone     String    @default("")
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  proofs    ClaimProof[]

  @@index([salonId])
}

// Salted hashes only. The raw IP address and email are not stored.
model RateLimit {
  id          String   @id @default(cuid())
  bucket      String
  subjectHash String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([bucket, subjectHash, windowStart])
  @@index([windowStart])
}

// One row per visitor, salon, local day, and kind. Deleted after about 30 days.
model StatDedup {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  day         DateTime @db.Date
  kind        String
  visitorHash String
  createdAt   DateTime @default(now())

  @@unique([salonId, day, kind, visitorHash])
  @@index([createdAt])
}

// Old and new values for listing edits that may need a review.
model ListingAudit {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  actorId   String?
  field     String
  oldValue  String   @default("")
  newValue  String   @default("")
  createdAt DateTime @default(now())

  @@index([salonId, createdAt])
}

// Proves the claimant controls the invite email. The password is stored only as a hash.
model ClaimProof {
  id           String      @id @default(cuid())
  tokenHash    String      @unique
  codeHash     String
  inviteId     String
  invite       ClaimInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  email        String
  name         String      @default("")
  passwordHash String      @default("")
  phone        String      @default("")
  userId       String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime    @default(now())

  @@index([inviteId])
}
