generator client {
  provider = "prisma-client-js"
}

// Local development and production both use Postgres. See DEPLOY.md.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// OWNER accounts self-signup. ADMIN is seeded from env, never chosen on the public form.
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String?
  role         String      @default("OWNER")
  referralCode String?
  isDemo       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  salon        Salon?
  magicLinks   MagicLink[]
}

model MagicLink {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// A launch city. Copy, URLs, and the home picker all read this table.
// intro is written by the team. An empty intro keeps the city page out of the index.
model City {
  slug          String         @id
  name          String
  countryCode   String         @default("IN")
  dialCode      String         @default("91")
  timezone      String         @default("Asia/Kolkata")
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  intro         String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  localities    Locality[]
  serviceGuides ServiceGuide[]
  salons        Salon[]
}

model Locality {
  id        String  @id @default(cuid())
  citySlug  String
  city      City    @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
  slug      String
  name      String
  intro     String  @default("")
  sortOrder Int     @default(0)
  salons    Salon[]

  @@unique([citySlug, slug])
  @@index([citySlug, sortOrder])
}

// A service landing page for one city, such as /{city}/service/haircut.
// query is the lowercase phrase matched against a salon's search text.
model ServiceGuide {
  id        String @id @default(cuid())
  citySlug  String
  city      City   @relation(fields: [citySlug], references: [slug], onDelete: Cascade)
  slug      String
  name      String
  query     String
  intro     String @default("")
  sortOrder Int    @default(0)

  @@unique([citySlug, slug])
  @@index([citySlug, sortOrder])
}

// status: DRAFT | PENDING | LIVE | HIDDEN
// gender: MEN | WOMEN | UNISEX
model Salon {
  id             String        @id @default(cuid())
  ownerId        String        @unique
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  citySlug       String
  city           City          @relation(fields: [citySlug], references: [slug])
  name           String
  slug           String
  areaSlug       String
  locality       Locality      @relation(fields: [citySlug, areaSlug], references: [citySlug, slug])
  address        String
  description    String        @default("")
  phone          String        @default("")
  whatsapp       String        @default("")
  gender         String        @default("UNISEX")
  status         String        @default("DRAFT")
  isEarlyPartner Boolean       @default(true)
  isDemo         Boolean       @default(false)
  referralCode   String?
  startingPrice  Int?
  searchBlob     String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  photos         Photo[]
  services       Service[]
  hours          OpeningHour[]

  @@unique([citySlug, areaSlug, slug])
  @@index([status, citySlug, areaSlug])
  @@index([isDemo])
}

model Photo {
  id         String @id @default(cuid())
  salonId    String
  salon      Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  alt        String @default("")
  sortOrder  Int    @default(0)

  @@index([salonId])
}

model Service {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  category    String
  priceInr    Int
  durationMin Int
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([salonId])
}

// dayOfWeek: 0 Monday … 6 Sunday. Times are 24h "HH:MM" in the city's timezone.
model OpeningHour {
  id        String  @id @default(cuid())
  salonId   String
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  closed    Boolean @default(false)
  openTime  String  @default("10:00")
  closeTime String  @default("20:00")

  @@unique([salonId, dayOfWeek])
}

// key "requireApproval": "true" | "false"
model SiteSetting {
  key   String @id
  value String
}
