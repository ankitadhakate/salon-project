# Local Postgres. Production must be a postgres:// or postgresql:// URL. See DEPLOY.md.
DATABASE_URL="postgresql://saj:saj@127.0.0.1:5432/saj"

# At least 32 characters in production. The placeholders in this file are rejected there.
AUTH_SECRET="replace-with-a-long-random-string"

# Public origin, no trailing slash. The session cookie is Secure when this is https.
# First launch: https://notsooboring.com
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3847"

# Shown in the header, titles, and emails. Defaults to Saj.
SITE_NAME="Saj"

# Search engines. Must be the string "true" to allow indexing.
# While false: every page is noindex, robots.txt disallows /, and /sitemap.xml is 404.
ALLOW_INDEXING="false"

# Approved non-sample salons required before a city, area, or service page can be indexed.
# Those pages also need a non-empty intro written in the admin.
INDEX_MIN_SALONS="8"

# Admin is created on first seed. Production rejects passwords under 12 characters
# and the development passwords listed in lib/production.ts.
ADMIN_EMAIL="admin@saj.local"
ADMIN_PASSWORD="saj-admin-dev"
ADMIN_NAME="Admin"

# Leave unset to keep the review step on. "true" publishes a listing as soon as the owner submits.
# AUTO_APPROVE_LISTINGS="false"

# Sample listings show in development and stay hidden in production unless you opt in.
# They stay in the database, labelled Sample, either way.
# SHOW_DEMO_LISTINGS="true"

# Set to true and re-run the seed to replace the admin password.
# The seed refuses to run when NODE_ENV=production. Production boot uses prisma/ensure-admin.ts.
# SEED_RESET_ADMIN_PASSWORD="false"

# Optional off-site database dumps. scripts/pg-dump.sh uploads when this is set.
# It reuses S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, and S3_REGION.
# BACKUP_S3_BUCKET=""

# Magic-link email. Without SMTP, development shows the link on screen.
# Production never shows the raw link.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Saj <hello@notsooboring.com>"

# Image storage. Development default is local files in public/uploads.
# Production requires IMAGE_DRIVER=s3 so a redeploy does not drop photos.
# IMAGE_DRIVER="s3"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT="https://ACCOUNT.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://images.notsooboring.com"
# S3_FORCE_PATH_STYLE="false"

# Maps. Leave unset for free OpenStreetMap tiles and Nominatim search. No API key.
# NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap"
# GEOCODER_URL="https://nominatim.openstreetmap.org/search"

# Extra hosts allowed to call server actions, if a proxy changes the host.
# ACTION_ALLOWED_ORIGINS="notsooboring.com,www.notsooboring.com"
