DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3847"
ADMIN_EMAIL="admin@saj.local"
ADMIN_PASSWORD="saj-admin-dev"
ADMIN_NAME="Saj Admin"

# Leave unset to keep the review step on. "true" publishes a listing as soon as the owner submits.
# AUTO_APPROVE_LISTINGS="false"

# Sample listings show in development and stay hidden in production unless you opt in.
# SHOW_DEMO_LISTINGS="true"

# Magic-link email. Without SMTP, development shows the link on screen.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Saj <hello@yourdomain.com>"

# Image storage. Default is local files in public/uploads.
# IMAGE_DRIVER="s3"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT="https://ACCOUNT.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://images.yourdomain.com"
# S3_FORCE_PATH_STYLE="false"

# Extra hosts allowed to call server actions, if a proxy changes the host.
# ACTION_ALLOWED_ORIGINS="yourdomain.com"
